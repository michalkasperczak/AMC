<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testy protokolu hosta AMC-wx-Lite. CELOWO net8.0 (bez -windows):
    warstwa protokolu musi byc wolna od Windows, zeby dala sie wykonac w WSL.
    Linkujemy te same pliki zrodlowe, ktorych uzywa host.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AccessibleMediaController.LiteHost.ProtocolTests</RootNamespace>
    <AssemblyName>amc_lite_protocol_tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AccessibleMediaController.Core\AccessibleMediaController.Core.csproj" />
    <Compile Include="*.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\Protocol\**\*.cs"
             Link="Protocol\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\AccessibleMediaController.AppleMusicWebHost\WebCommand.cs"
             Link="AppleMusicWebHost\WebCommand.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteBookmarkStore.cs"
             Link="LiteBookmarkStore.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LitePodcastProgressStore.cs"
             Link="LitePodcastProgressStore.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LitePodcastChapterCoordinator.cs"
             Link="LitePodcastChapterCoordinator.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.Windows\Services\PodcastChapterClient.cs"
             Link="PodcastChapterClient.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.Windows\Services\FacebookPublicPageClient.cs"
             Link="FacebookPublicPageClient.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteFreshProfileInitializer.cs"
             Link="LiteFreshProfileInitializer.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteFrontierSmartPinStore.cs"
             Link="LiteFrontierSmartPinStore.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LitePlaybackHistoryMutation.cs"
             Link="LitePlaybackHistoryMutation.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteRadioLibraryMutation.cs"
             Link="LiteRadioLibraryMutation.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteRadioFavoritesExport.cs"
             Link="LiteRadioFavoritesExport.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteWiiMProfileMutation.cs"
             Link="LiteWiiMProfileMutation.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteWiiMNetworkStreamExport.cs"
             Link="LiteWiiMNetworkStreamExport.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteSonosOwnStreamsMutation.cs"
             Link="LiteSonosOwnStreamsMutation.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteSonosOwnStreamsExport.cs"
             Link="LiteSonosOwnStreamsExport.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteSpotifyCatalogCoordinator.cs"
             Link="LiteSpotifyCatalogCoordinator.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteYouTubeAccountCoordinator.cs"
             Link="LiteYouTubeAccountCoordinator.cs" />
    <Compile Include="..\..\src\AccessibleMediaController.LiteHost\LiteAccountSettingsStore.cs"
             Link="LiteAccountSettingsStore.cs" />
  </ItemGroup>
</Project>
