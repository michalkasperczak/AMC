<Window x:Class="AccessibleMediaController.Windows.ShortcutCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Zmiana skrótu" Width="500" Height="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="18">
        <TextBlock x:Name="CommandText" FontWeight="SemiBold" Margin="0,0,0,12"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="Naciśnij nową kombinację. Zastąpi ona cały poprzedni skrót. Sam Escape anuluje. Po przechwyceniu naciśnij zwykły Enter, aby zapisać." TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="CapturedText" IsReadOnly="True" FontSize="18" Margin="0,0,0,18"
                 automation:AutomationProperties.Name="Przechwycony skrót"
                 automation:AutomationProperties.HelpText="Pole tylko do odczytu. Naciśnięta kombinacja zastępuje cały poprzedni skrót." />
        <controls:AccessibleStatusTextBlock x:Name="CaptureStatus" Margin="0,0,0,12"
                    automation:AutomationProperties.Name="Wynik przechwytywania skrótu"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    Text="Oczekiwanie na nową kombinację" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Width="95" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Ok_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
