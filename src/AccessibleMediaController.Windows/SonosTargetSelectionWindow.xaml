<Window x:Class="AccessibleMediaController.Windows.SonosTargetSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Cel sterowania Sonos" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      WYBOR CELU STEROWANIA (Ctrl+F5). Okno NIE GRA, nie tworzy i nie rozwiazuje
      grup: zmienia wylacznie to, do czego AMC adresuje polecenia. Ruch
      zaznaczeniem nic nie zapisuje - zapis jest dopiero na "Ustaw jako cel".

      Uklad jak w odebranym wyborze domu: naglowek, wstep, lista, przyciski,
      status. Przycisk potwierdzenia celowo NIE nazywa sie "Odtwórz".
    -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="Cel sterowania Sonos"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="IntroductionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" />
        <controls:AccessibleStatusTextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmButton" Width="130" Content="_Ustaw jako cel" Margin="0,0,8,0"
                    automation:AutomationProperties.Name="Ustaw jako cel"
                    Click="Confirm_Click" />
            <Button x:Name="CloseButton" Width="95" Content="_Zamknij"
                    IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <ListBox x:Name="GroupsList" DisplayMemberPath="Label" TextSearch.TextPath="Label"
                 automation:AutomationProperties.Name="Grupy Sonos jako cel sterowania">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
