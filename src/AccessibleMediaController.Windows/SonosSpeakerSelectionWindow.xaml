<Window x:Class="AccessibleMediaController.Windows.SonosSpeakerSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Wybór głośników Sonos" Width="580" Height="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      WYBOR GLOSNIKOW (Ctrl+F5 -> "Wybierz glosniki"). Ruch zaznaczeniem NIC nie
      wysyla - jedna intencja i jeden POST sa dopiero na "Zastosuj".

      LISTA: ItemsControl w ScrollViewer z PRAWDZIWYMI CheckBox. Czytnik ekranu
      ma wiec wlasciwa role (pole wyboru) i wlasciwy stan (zaznaczone/
      niezaznaczone) na TEJ kontrolce, ktora dostaje fokus - nie na opakowaniu
      ListBoxItem, ktore stanu by nie podalo.
    -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="Wybór głośników Sonos"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="IntroductionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" />
        <controls:AccessibleStatusTextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SelectAllButton" Width="150" Content="_Zaznacz wszystkie" Margin="0,0,8,0"
                    automation:AutomationProperties.Name="Zaznacz wszystkie"
                    Click="SelectAll_Click" />
            <Button x:Name="ApplyButton" Width="110" Content="_Zastosuj" Margin="0,0,8,0"
                    automation:AutomationProperties.Name="Zastosuj"
                    Click="Apply_Click" />
            <Button x:Name="CancelButton" Width="95" Content="_Anuluj"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
        <ScrollViewer x:Name="SpeakersScroll" VerticalScrollBarVisibility="Auto"
                      automation:AutomationProperties.Name="Głośniki domu Sonos">
            <ItemsControl x:Name="SpeakersList" KeyboardNavigation.TabNavigation="Once">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                          PRAWDZIWY CheckBox: rola i stan trafiaja do czytnika z
                          tej kontrolki. Nazwa to PELNA nazwa glosnika z odczytu.
                        -->
                        <CheckBox Margin="2,4,2,4" Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  automation:AutomationProperties.Name="{Binding Name}"
                                  automation:AutomationProperties.HelpText="{Binding HelpText}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
