<Window x:Class="AccessibleMediaController.Windows.SonosFavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Ulubione Sonos" Width="520" Height="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="Ulubione Sonos"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="IntroductionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" />
        <!-- STATUS: widoczny tekst ORAZ programowy komunikat czytnika przez
             ISTNIEJACY AccessibleStatusTextBlock. Bez klikania po NVDA i bez
             wlasnej kolejki mowy. -->
        <controls:AccessibleStatusTextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PlayButton" Width="95" Content="_Odtwórz" Margin="0,0,8,0"
                    Click="Play_Click" />
            <Button x:Name="CloseButton" Width="95" Content="_Zamknij"
                    IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <ListBox x:Name="FavoritesList" DisplayMemberPath="Label" TextSearch.TextPath="Label"
                 automation:AutomationProperties.Name="Ulubione Sonos">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
