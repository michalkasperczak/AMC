<Window x:Class="AccessibleMediaController.Windows.SonosPlaylistsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Playlisty Sonos" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      PLAYLISTY SONOSA z konta. Uklad celowo identyczny z odebranym oknem
      ulubionych: naglowek, wstep, lista, przyciski, status - zeby nie powstawal
      drugi, wlasny wzorzec prezentacji.

      Enter albo "Odtwórz" wysyla DOKLADNIE JEDEN loadPlaylist do AKTYWNEJ grupy.
      Samo otwarcie, ruch strzalkami i Tab NIE wysylaja niczego.
    -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="Playlisty Sonos"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="IntroductionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" />
        <controls:AccessibleStatusTextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PlayButton" Width="110" Content="_Odtwórz" Margin="0,0,8,0"
                    automation:AutomationProperties.Name="Odtwórz"
                    Click="Play_Click" />
            <Button x:Name="CloseButton" Width="95" Content="_Zamknij"
                    IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <ListBox x:Name="PlaylistsList" DisplayMemberPath="Label" TextSearch.TextPath="Label"
                 automation:AutomationProperties.Name="Playlisty Sonos">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
