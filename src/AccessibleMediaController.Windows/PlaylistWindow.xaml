<Window x:Class="AccessibleMediaController.Windows.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Przynależność do playlist" Width="620" Height="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="DescriptionText" Margin="0,0,0,8"
                       TextWrapping="Wrap" automation:AutomationProperties.HeadingLevel="Level1" />
            <Label Target="{Binding ElementName=FilterBox}">_Filtruj playlisty:</Label>
            <TextBox x:Name="FilterBox"
                     automation:AutomationProperties.Name="Filtruj playlisty"
                     TextChanged="FilterBox_TextChanged" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="90" Margin="0,0,8,0" Content="_Nowa…" Click="New_Click" />
            <Button Width="115" Margin="0,0,8,0" Content="Zmień _nazwę…" Click="Rename_Click" />
            <Button Width="115" Margin="0,0,18,0" Content="_Usuń playlistę…" Click="Delete_Click" />
            <Button Width="85" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Save_Click" />
            <Button Width="85" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
        <controls:AccessibleStatusTextBlock x:Name="PlaylistStatus" DockPanel.Dock="Bottom"
                                            Margin="0,8,0,0" TextWrapping="Wrap"
                                            automation:AutomationProperties.LiveSetting="Polite" />
        <ListBox x:Name="PlaylistList" TextSearch.TextPath="Name"
                 automation:AutomationProperties.Name="Playlisty">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Membership}"
                              IsThreeState="True" IsHitTestVisible="False" Focusable="False" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
