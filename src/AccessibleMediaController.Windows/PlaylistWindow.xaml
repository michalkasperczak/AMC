<Window x:Class="AccessibleMediaController.Windows.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Przynależność do playlist" Width="520" Height="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" automation:AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="95" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Save_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="PlaylistList" TextSearch.TextPath="Name"
                 automation:AutomationProperties.Name="Playlisty">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding ContainsItem}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
