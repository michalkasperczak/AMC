<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.SonosDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Głośniki i grupy Sonos" Width="700" Height="540"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <!--
      GLOSNIKI I GRUPY SONOS: widok TYLKO DO ODCZYTU.

      Swiadomie NIE MA tu zadnego przycisku sterowania odtwarzaniem, a Enter i
      strzalki na listach NICZEGO nie uruchamiaja - to nie jest odtwarzacz i nie
      udaje odtwarzacza. Sa dokladnie dwie operacje: Odswiez i Zamknij.

      Kolejnosc odczytu wynika z BUDOWY okna, nie z opoznienia: pierwsza stoi
      czytelna instrukcja w polu tylko do odczytu, z fokusem startowym i
      najnizszym numerem tabulacji. Zadnego timera i zadnego pollingu.
    -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Głośniki i grupy Sonos" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <controls:AccessibleStatusTextBlock x:Name="OperationStatusText" Margin="0,0,0,10"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.Name="Ostatni komunikat listy urządzeń Sonos" />
            <WrapPanel>
                <Button x:Name="RefreshButton" Content="_Odśwież" Margin="0,0,8,8"
                        TabIndex="40"
                        automation:AutomationProperties.Name="Odśwież listę urządzeń"
                        Click="Refresh_Click" />
                <Button x:Name="CloseButton" Content="Za_mknij" IsCancel="True" Margin="0,0,0,8"
                        TabIndex="50"
                        automation:AutomationProperties.Name="Zamknij"
                        Click="Close_Click" />
            </WrapPanel>
        </StackPanel>

        <!--
          Tresc pierwsza jako POLE tylko do odczytu: czytnik czyta ja, bo tam
          stoi kursor, a uzytkownik moze ja przejrzec strzalkami.
        -->
        <TextBox x:Name="InstructionBox" DockPanel.Dock="Top"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="96"
                 VerticalScrollBarVisibility="Auto"
                 TabIndex="0"
                 BorderThickness="1"
                 Margin="0,0,0,10"
                 automation:AutomationProperties.Name="Stan listy urządzeń Sonos i instrukcja" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                    x:Name="HouseholdPanel">
            <Label x:Name="HouseholdLabel" Target="{Binding ElementName=HouseholdBox}"
                   Content="_Dom Sonos" />
            <ComboBox x:Name="HouseholdBox" TabIndex="10"
                      automation:AutomationProperties.Name="Dom Sonos"
                      SelectionChanged="Household_SelectionChanged" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <Label x:Name="GroupsLabel" Target="{Binding ElementName=GroupsList}"
                       Content="_Grupy" />
                <ListBox x:Name="GroupsList" Height="180" TabIndex="20"
                         automation:AutomationProperties.Name="Grupy Sonos" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <Label x:Name="PlayersLabel" Target="{Binding ElementName=PlayersList}"
                       Content="_Głośniki" />
                <ListBox x:Name="PlayersList" Height="180" TabIndex="30"
                         automation:AutomationProperties.Name="Głośniki Sonos i udział w grupie" />
            </StackPanel>
        </Grid>
    </DockPanel>
</controls:AccessibleWindow>
