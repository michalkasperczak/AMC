<Window x:Class="AccessibleMediaController.Windows.RenameLocalItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="560" Height="235" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" Margin="0,0,0,8" TextWrapping="Wrap"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="HelpText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <Label x:Name="NameLabel" Target="{Binding ElementName=NameBox}">_Nowa nazwa:</Label>
        <TextBox x:Name="NameBox" MaxLength="240" Margin="0,0,0,16"
                 automation:AutomationProperties.HelpText="Enter zatwierdza, Escape anuluje." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="105" Margin="0,0,8,0" Content="_Zmień nazwę"
                    IsDefault="True" Click="Save_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
