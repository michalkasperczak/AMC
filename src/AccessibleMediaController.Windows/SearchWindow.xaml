<Window x:Class="AccessibleMediaController.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Width="680" Height="480" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="ScopeText" Margin="0,4,0,10" TextWrapping="Wrap" />
            <Label Target="{Binding ElementName=SearchBox}">_Wyszukiwany tekst:</Label>
            <TextBox x:Name="SearchBox" Margin="0,0,0,8"
                     automation:AutomationProperties.Name="Wyszukiwany tekst"
                     automation:AutomationProperties.HelpText="Wpisz tekst i naciśnij Enter, aby rozpocząć wyszukiwanie. Escape zamyka okno."
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <controls:AccessibleStatusTextBlock x:Name="SearchStatus" Margin="0,0,0,8"
                                                Text="Wpisz tekst i naciśnij Enter"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="_Szukaj" IsDefault="True" Click="Search_Click" />
            <Button Width="100" Margin="0,0,8,0" Content="_Otwórz" Click="Open_Click" />
            <Button Width="100" Content="_Anuluj" IsCancel="True" />
        </StackPanel>

        <ListBox x:Name="ResultsList" DisplayMemberPath="Label"
                 automation:AutomationProperties.Name="Wyniki wyszukiwania"
                 automation:AutomationProperties.HelpText="Enter otwiera wybrany wynik. Escape zamyka okno."
                 PreviewKeyDown="ResultsList_PreviewKeyDown"
                 MouseDoubleClick="ResultsList_MouseDoubleClick" />
    </DockPanel>
</Window>
