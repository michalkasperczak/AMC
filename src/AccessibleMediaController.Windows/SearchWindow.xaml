<Window x:Class="AccessibleMediaController.Windows.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Width="680" Height="480" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" FontSize="19" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="ScopeText" Margin="0,4,0,10" TextWrapping="Wrap" />
            <Label Target="{Binding ElementName=SearchBox}">_Wyszukiwany tekst:</Label>
            <TextBox x:Name="SearchBox" Margin="0,0,0,8"
                     automation:AutomationProperties.Name="Wyszukiwany tekst"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                     TextChanged="SearchBox_TextChanged" />
            <controls:AccessibleStatusTextBlock x:Name="SearchStatus" Margin="0,0,0,8"
                                                Text="Wpisz tekst i naciśnij Enter"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SearchButton" Width="100" Margin="0,0,8,0" Content="_Szukaj" IsDefault="True" Click="Search_Click" />
            <Button Width="100" Margin="0,0,8,0" Content="_Otwórz" Click="Open_Click" />
            <Button Width="100" Content="_Anuluj" IsCancel="True" />
        </StackPanel>

        <ListBox x:Name="ResultsList" DisplayMemberPath="Label" SelectionMode="Extended"
                 TextSearch.TextPath="NavigationText"
                 PreviewKeyDown="ResultsList_PreviewKeyDown"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.HelpText" Value="{Binding Hint}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu Opened="ResultsContextMenu_Opened" Closed="ResultsContextMenu_Closed">
                    <MenuItem Header="_Otwórz" InputGestureText="Enter"
                              automation:AutomationProperties.AcceleratorKey="Enter"
                              Click="Open_Click" />
                    <MenuItem Header="Odtwórz lub _wstrzymaj" InputGestureText="Ctrl+Enter"
                              automation:AutomationProperties.AcceleratorKey="Control+Enter"
                              Click="TogglePlayback_Click" />
                    <MenuItem x:Name="SearchPlayNextMenuItem" Header="Odtwórz jako _następne" InputGestureText="Ctrl+Shift+Enter"
                              automation:AutomationProperties.AcceleratorKey="Control+Shift+Enter"
                              Click="PlayNext_Click" />
                    <MenuItem x:Name="SearchQueueMenuItem" Header="Dodaj do _kolejki" InputGestureText="Shift+Enter"
                              automation:AutomationProperties.AcceleratorKey="Shift+Enter"
                              Click="Queue_Click" />
                    <Separator x:Name="SearchQueueSeparator" />
                    <MenuItem Header="Dodaj lub usuń z _ulubionych" InputGestureText="Ctrl+Shift+U"
                              automation:AutomationProperties.AcceleratorKey="Control+Shift+U"
                              Click="Favorite_Click" />
                    <MenuItem Header="Dodaj lub usuń z _Biblioteki" InputGestureText="Ctrl+Shift+L"
                              automation:AutomationProperties.AcceleratorKey="Control+Shift+L"
                              Click="Library_Click" />
                    <MenuItem x:Name="SearchPlaylistMenuItem" Header="Zarządzaj _playlistami" InputGestureText="Ctrl+Shift+P"
                              automation:AutomationProperties.AcceleratorKey="Control+Shift+P"
                              Click="Playlist_Click" />
                    <MenuItem Header="_Informacje" InputGestureText="Alt+Enter"
                              automation:AutomationProperties.AcceleratorKey="Alt+Enter"
                              Click="Information_Click" />
                    <Separator />
                    <MenuItem Header="Kopiuj _nazwę" InputGestureText="Ctrl+C"
                              automation:AutomationProperties.AcceleratorKey="Control+C"
                              Click="CopyName_Click" />
                    <MenuItem Header="Kopiuj ścieżkę lub łącze" InputGestureText="Ctrl+Shift+C"
                              automation:AutomationProperties.AcceleratorKey="Control+Shift+C"
                              Click="CopyLocation_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</Window>
