<Window x:Class="AccessibleMediaController.Windows.PodcastOpmlImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="760" Height="520" MinWidth="620" MinHeight="390"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Importuj podcasty z OPML" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Wybierz kanały do dodania. Ctrl+A zaznacza wszystkie. AMC pobierze tylko małe metadane RSS lub Atom; pliki audio nie będą pobierane." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="110" Margin="0,0,8,0" Content="_Importuj" IsDefault="True" Click="Import_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
        <ListBox x:Name="FeedsList" SelectionMode="Extended" DisplayMemberPath="Label"
                 TextSearch.TextPath="Label" automation:AutomationProperties.Name="Kanały podcastów znalezione w pliku OPML">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
