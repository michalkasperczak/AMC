<Application x:Class="AccessibleMediaController.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls">
    <Application.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="controls:EditableFieldSelection.ReplaceOnKeyboardFocus" Value="True" />
        </Style>
    </Application.Resources>
</Application>
