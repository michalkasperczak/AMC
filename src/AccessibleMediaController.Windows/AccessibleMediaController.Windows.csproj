<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AccessibleMediaController.Windows</RootNamespace>
    <AssemblyName>AccessibleMediaController</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccessibleMediaController.Core\AccessibleMediaController.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" GeneratePathProperty="true" />
    <PackageReference Include="NLayer" Version="2.0.1" GeneratePathProperty="true" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" GeneratePathProperty="true" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" GeneratePathProperty="true" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\NAudio-MIT.txt"
          Link="licenses\NAudio-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\NLayer-MIT.txt"
          Link="licenses\NLayer-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\Vorbis-components-MIT.txt"
          Link="licenses\Vorbis-components-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\Microsoft.Data.Sqlite-MIT.txt"
          Link="licenses\Microsoft.Data.Sqlite-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLitePCLRaw-Apache-2.0.txt"
          Link="licenses\SQLitePCLRaw-Apache-2.0.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLitePCLRaw-Apache-2.0.txt"
          Link="licenses\TIDAL-SDK-Web-Apache-2.0.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt"
          Link="licenses\Microsoft-WebView2-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt"
          Link="licenses\Microsoft-WebView2-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLite-public-domain.txt"
          Link="licenses\SQLite-public-domain.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\third_party\BASS\win-x64\bass.dll"
          Link="bass.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\BASS-2.4.txt"
          Link="licenses\BASS-2.4.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\ShazamIO-MIT.txt"
          Link="licenses\ShazamIO-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgSoundTouch_Net)\LICENSE\LICENSE"
          Link="licenses\SoundTouch.Net-LGPL-2.1.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="TidalPlayerHost\index.html"
          Link="tidal-player\index.html"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="TidalPlayerHost\dist\tidal-player.js"
          Link="tidal-player\tidal-player.js"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="ExcludeReplaceableSoundTouchAssembliesFromSingleFile"
          BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'SoundTouch.Net' Or '%(Filename)' == 'SoundTouch.Net.NAudioSupport' Or '%(Filename)' == 'bass' Or '%(Filename)' == 'Microsoft.Web.WebView2.Core' Or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'WebView2Loader'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
