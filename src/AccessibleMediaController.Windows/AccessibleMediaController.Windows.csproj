<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 2026-09-16: wersja SDK w TFM daje dostep do Windows.Media.Control
         (systemowe sterowanie mediami), potrzebnego do sterowania GRAJACA
         oryginalna aplikacja TIDAL. 10.0.19041 to Windows 10 2004 - minimum
         dla SMTC.
         UWAGA: komentarz z 11.09 obiecywal ten TFM, ale w pliku stalo samo
         "net8.0-windows" - obietnica nie byla dotrzymana i Windows.Media.Control
         nie bylo dostepne. Numer wersji MUSI tu byc, inaczej using Windows.Media.Control
         nie kompiluje sie. Ten sam TFM musi miec projekt testow Windows,
         inaczej blad NU1201. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AccessibleMediaController.Windows</RootNamespace>
    <AssemblyName>AccessibleMediaController</AssemblyName>
    <!-- 2026-09-13: node_modules odtwarzacza TIDAL MUSI byc wykluczone z wyszukiwania
         plikow projektu. pnpm zaklada tam zlacza katalogow (junction), a Windows
         odmawia wejscia w nie jako "niezaufany punkt instalacji" - wyszukiwanie
         **/*.xaml przewracalo sie wtedy z bledem BG1002 "Nie mozna odnalezc pliku
         **/*.xaml", mimo ze wszystkie 35 plikow XAML lezalo na miejscu. Bez tego
         wykluczenia CALY projekt Windows sie nie kompiluje. Nie usuwac. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TidalPlayerHost\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccessibleMediaController.Core\AccessibleMediaController.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" GeneratePathProperty="true" />
    <PackageReference Include="NLayer" Version="2.0.1" GeneratePathProperty="true" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" GeneratePathProperty="true" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" GeneratePathProperty="true" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\NAudio-MIT.txt"
          Link="licenses\NAudio-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\NLayer-MIT.txt"
          Link="licenses\NLayer-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\Vorbis-components-MIT.txt"
          Link="licenses\Vorbis-components-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\Microsoft.Data.Sqlite-MIT.txt"
          Link="licenses\Microsoft.Data.Sqlite-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLitePCLRaw-Apache-2.0.txt"
          Link="licenses\SQLitePCLRaw-Apache-2.0.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLitePCLRaw-Apache-2.0.txt"
          Link="licenses\TIDAL-SDK-Web-Apache-2.0.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\LICENSE.txt"
          Link="licenses\Microsoft-WebView2-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\NOTICE.txt"
          Link="licenses\Microsoft-WebView2-NOTICE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\SQLite-public-domain.txt"
          Link="licenses\SQLite-public-domain.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\third_party\BASS\win-x64\bass.dll"
          Link="bass.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\BASS-2.4.txt"
          Link="licenses\BASS-2.4.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\ShazamIO-MIT.txt"
          Link="licenses\ShazamIO-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgSoundTouch_Net)\LICENSE\LICENSE"
          Link="licenses\SoundTouch.Net-LGPL-2.1.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="TidalPlayerHost\index.html"
          Link="tidal-player\index.html"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="TidalPlayerHost\dist\tidal-player.js"
          Link="tidal-player\tidal-player.js"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- Silnik Spotify. Bez tych dwoch wpisow pliki NIE trafiaja do paczki
         i odtwarzanie zglasza brak skladnikow dopiero u uzytkownika.
         Mostek Spotify nie przechodzi przez bundler: SDK jest wczytywane ze
         strony Spotify, wiec zrodlo idzie do paczki bez przetwarzania. -->
    <None Include="SpotifyPlayerHost\index.html"
          Link="spotify-player\index.html"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="SpotifyPlayerHost\src\bridge.js"
          Link="spotify-player\bridge.js"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <!-- Drugi silnik Spotify: natywny host Librespot. Istnieje OBOK mostka SDK
         wyzej, nie zamiast niego - uzytkownik wybiera silnik, a paczka musi
         zawierac oba. Fabryka szuka dokladnie
         AppContext.BaseDirectory\LibrespotHost\amc_spotify_librespot_host.exe,
         wiec Link MUSI trzymac ten katalog. Bez tego wpisu plik nie trafia do
         publikacji i brak silnika wychodzi dopiero u uzytkownika.
         Plik jest przypiety kopia w repozytorium (jak bass.dll); suma SHA-256
         jest sprawdzana w celu VerifyPinnedLibrespotHostBinary ponizej. -->
    <None Include="..\..\third_party\LibrespotHost\win-x64\amc_spotify_librespot_host.exe"
          Link="LibrespotHost\amc_spotify_librespot_host.exe"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\librespot-dependencies\**\*"
          Link="licenses\librespot-dependencies\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\licenses\librespot-MIT.txt"
          Link="licenses\librespot-MIT.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="..\..\third_party\LibrespotHost\win-x64\provenance-amc-host.json"
          Link="LibrespotHost\provenance-amc-host.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Proweniencja: GitHub Actions run 35381167099, librespot 0.8.0
         (d36f9f1907e8cc9d68a93f8ebc6b627b1bf7267d), AMC 791c8dbf.
         Zmiana binarki bez zmiany tej sumy jest bledem budowania. -->
    <LibrespotHostExpectedSha256>f5b614f01d8943b5872d9a2bb86658761198b763bb25c1647aa79268a2473c8e</LibrespotHostExpectedSha256>
    <LibrespotHostBinaryPath>$(MSBuildThisFileDirectory)..\..\third_party\LibrespotHost\win-x64\amc_spotify_librespot_host.exe</LibrespotHostBinaryPath>
  </PropertyGroup>
  <!-- Straznik pakowania. Mierzy REALNY plik, nie deklaracje: brak pliku albo
       inna suma konczy budowanie bledem, zeby nie wydac paczki z podmieniona
       lub nieobecna natywna binarka. -->
  <Target Name="VerifyPinnedLibrespotHostBinary"
          BeforeTargets="Build;Publish"
          Condition="'$(OS)' == 'Windows_NT' Or '$(MSBuildRuntimeType)' == 'Core'">
    <Error Condition="!Exists('$(LibrespotHostBinaryPath)')"
           Text="Brak przypietej binarki hosta Librespot: $(LibrespotHostBinaryPath). Bez niej silnik Librespot NIE zagra u uzytkownika." />
    <GetFileHash Files="$(LibrespotHostBinaryPath)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_LibrespotHostHashed" />
    </GetFileHash>
    <Error Condition="'%(_LibrespotHostHashed.FileHash)' != '$(LibrespotHostExpectedSha256)'"
           Text="Suma SHA-256 hosta Librespot niezgodna z przypieta proweniencja. Oczekiwano $(LibrespotHostExpectedSha256), jest %(_LibrespotHostHashed.FileHash)." />
  </Target>
  <Target Name="ExcludeReplaceableSoundTouchAssembliesFromSingleFile"
          BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)' == 'SoundTouch.Net' Or '%(Filename)' == 'SoundTouch.Net.NAudioSupport' Or '%(Filename)' == 'bass' Or '%(Filename)' == 'Microsoft.Web.WebView2.Core' Or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'WebView2Loader'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
