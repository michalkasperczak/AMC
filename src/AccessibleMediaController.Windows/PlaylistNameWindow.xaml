<Window x:Class="AccessibleMediaController.Windows.PlaylistNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nazwa playlisty" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Label Target="{Binding ElementName=NameBox}" Content="_Nazwa playlisty:" />
        <TextBox x:Name="NameBox" MaxLength="200" Margin="0,0,0,16"
                 AutomationProperties.Name="Nazwa playlisty" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="95" Margin="0,0,8,0" Content="_OK" IsDefault="True" Click="Save_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
