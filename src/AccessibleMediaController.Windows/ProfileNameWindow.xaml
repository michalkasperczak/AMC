<Window x:Class="AccessibleMediaController.Windows.ProfileNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nazwa profilu" Width="440" Height="190"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Label Target="{Binding ElementName=NameBox}">_Nazwa profilu:</Label>
        <TextBox x:Name="NameBox" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="95" Margin="0,0,8,0" Content="_OK" IsDefault="True" Click="Ok_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
