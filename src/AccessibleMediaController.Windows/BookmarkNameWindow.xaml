<Window x:Class="AccessibleMediaController.Windows.BookmarkNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Nazwa zakładki" Width="520" Height="215"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="ContextText" Margin="0,0,0,10" TextWrapping="Wrap"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <Label Target="{Binding ElementName=NameBox}">_Nazwa zakładki:</Label>
        <TextBox x:Name="NameBox" MaxLength="200" Margin="0,0,0,16"
                 automation:AutomationProperties.HelpText="Maksymalnie 200 znaków. Enter zapisuje, Escape anuluje." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="95" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Save_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
