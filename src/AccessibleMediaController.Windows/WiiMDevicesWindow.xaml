<Window x:Class="AccessibleMediaController.Windows.WiiMDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Urządzenia WiiM" Width="760" Height="530" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Urządzenia WiiM" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Wykrywanie korzysta z lokalnego UPnP. Jeżeli router lub zapora je blokuje, wpisz adres IP widoczny w WiiM Home. AMC zapisuje adres urządzenia, ale nie zapisuje hasła ani danych kont usług muzycznych." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="OperationStatusText" Margin="0,0,0,8" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Wynik operacji"
                       automation:AutomationProperties.LiveSetting="Assertive" />
            <Label Target="{Binding ElementName=AddressBox}">_Adres IP urządzenia:</Label>
            <WrapPanel Margin="0,0,0,8">
                <TextBox x:Name="AddressBox" Width="230" Margin="0,0,8,0"
                         automation:AutomationProperties.Name="Adres IP urządzenia WiiM"
                         automation:AutomationProperties.HelpText="Przykład: 192.168.1.25" />
                <Button x:Name="AddButton" Content="_Dodaj i sprawdź" Click="Add_Click" />
            </WrapPanel>
            <WrapPanel HorizontalAlignment="Left">
                <Button x:Name="DiscoverButton" Margin="0,0,8,8" Content="_Wykryj w sieci" Click="Discover_Click" />
                <Button x:Name="RefreshButton" Margin="0,0,8,8" Content="_Odśwież wybrane" Click="Refresh_Click" />
                <Button x:Name="RemoveButton" Margin="0,0,8,8" Content="_Usuń urządzenie…" Click="Remove_Click" />
                <Button Margin="0,0,0,8" Content="_Zamknij" IsCancel="True" />
            </WrapPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="DevicesList" DisplayMemberPath="Label" TextSearch.TextPath="NavigationText"
                     automation:AutomationProperties.Name="Urządzenia WiiM"
                     SelectionChanged="DevicesList_SelectionChanged" />
            <TextBlock x:Name="DeviceDetailsText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Szczegóły wybranego urządzenia" />
        </Grid>
    </DockPanel>
</Window>
