<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Właściwości i informacje"
        Width="650" Height="500" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ContentRendered="Window_ContentRendered"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <controls:AccessibleStatusTextBlock x:Name="CopyStatusText"
                                                MinHeight="1"
                                                automation:AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ViewModeButton" MinWidth="105" Margin="0,0,8,0"
                        Content="Widok _dokumentu (F6)" Click="ViewMode_Click"
                        automation:AutomationProperties.HelpText="Przełącza widok tekstowy i dokument HTML. Skrót F6 działa w obu widokach." />
                <Button MinWidth="105" Margin="0,0,8,0" Content="_Kopiuj wszystko"
                        KeyboardNavigation.TabIndex="2"
                        automation:AutomationProperties.HelpText="Kopiuje pełną treść i pozostawia to okno otwarte"
                        Click="Copy_Click" />
                <Button MinWidth="105" IsCancel="True"
                        KeyboardNavigation.TabIndex="3"
                        Content="_Zamknij" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="LinksList"
                 DockPanel.Dock="Top"
                 MaxHeight="125"
                 Margin="0,0,0,10"
                 DisplayMemberPath="Label"
                 TextSearch.TextPath="Label"
                 KeyboardNavigation.TabIndex="1"
                 Visibility="Collapsed"
                 automation:AutomationProperties.Name="Łącza"
                 automation:AutomationProperties.HelpText="Strzałki wybierają łącze. Enter otwiera je w zewnętrznej aplikacji."
                 PreviewKeyDown="LinksList_PreviewKeyDown"
                 MouseDoubleClick="LinksList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <Grid>
            <wfi:WindowsFormsHost x:Name="InformationHost" KeyboardNavigation.TabIndex="0" />
            <wv2:WebView2 x:Name="InformationBrowser"
                          Visibility="Collapsed"
                          KeyboardNavigation.TabIndex="0"
                          automation:AutomationProperties.Name="Treść"
                          automation:AutomationProperties.HelpText="Tryb przeglądania czytnika ekranu. Escape zamyka okno."
                          NavigationStarting="InformationBrowser_NavigationStarting" />
        </Grid>
    </DockPanel>
</controls:AccessibleWindow>
