<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Właściwości i informacje"
        Width="650" Height="500" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ContentRendered="Window_ContentRendered"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button MinWidth="105" Margin="0,0,8,0" Content="_Kopiuj wszystko"
                    Click="Copy_Click" />
            <Button MinWidth="105" IsDefault="True" IsCancel="True"
                    Content="_Zamknij" Click="Close_Click" />
        </StackPanel>
        <ListBox x:Name="InformationList"
                 SelectionMode="Extended"
                 IsTextSearchEnabled="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 automation:AutomationProperties.Name="Właściwości i informacje" />
    </DockPanel>
</controls:AccessibleWindow>
