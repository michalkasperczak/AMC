<Window x:Class="AccessibleMediaController.Windows.RadioStationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="650" Height="310" MinWidth="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" Margin="0,0,0,8" TextWrapping="Wrap"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="HelpText" Margin="0,0,0,12" TextWrapping="Wrap" />
        <Label x:Name="NameLabel" Target="{Binding ElementName=NameBox}">_Nazwa stacji:</Label>
        <TextBox x:Name="NameBox" MaxLength="240" Margin="0,0,0,10"
                 automation:AutomationProperties.Name="Nazwa stacji" />
        <Label Target="{Binding ElementName=StreamBox}">Adres _strumienia:</Label>
        <TextBox x:Name="StreamBox" Margin="0,0,0,18"
                 automation:AutomationProperties.Name="Adres strumienia HTTP lub HTTPS"
                 automation:AutomationProperties.HelpText="Wpisz bezpośredni adres strumienia, playlisty M3U, M3U8 lub PLS. Nie wpisuj adresu zwykłej strony internetowej." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="105" Margin="0,0,8,0" Content="_Zapisz"
                    IsDefault="True" Click="Save_Click" />
            <Button Width="95" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
