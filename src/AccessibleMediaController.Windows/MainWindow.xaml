<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Dostępny kontroler multimedialny — prototyp"
        Width="820" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel>
        <wfi:WindowsFormsHost x:Name="PlaybackStatusHost" DockPanel.Dock="Bottom"
                              Height="24" Focusable="False"
                              KeyboardNavigation.IsTabStop="False" />

        <DockPanel Margin="12">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Margin="0,0,0,8"
              KeyboardNavigation.IsTabStop="False"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Otwórz pliki audio…" InputGestureText="Ctrl+O"
                          automation:AutomationProperties.Name="Otwórz pliki audio, Ctrl+O"
                          automation:AutomationProperties.AcceleratorKey="Ctrl+O"
                          Click="OpenLocalFiles_Click" />
                <MenuItem Header="Otwórz _folder z plikami audio…" InputGestureText="Ctrl+Shift+O"
                          automation:AutomationProperties.Name="Otwórz folder z plikami audio, Ctrl+Shift+O"
                          automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+O"
                          Click="OpenLocalFolder_Click" />
                <Separator />
                <MenuItem Header="_Ustawienia…" InputGestureText="Ctrl+," Click="Settings_Click" />
                <Separator />
                <MenuItem Header="_Zakończ" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edycja">
                <MenuItem Header="_Cofnij ostatnią zmianę" InputGestureText="Ctrl+Z" Click="Undo_Click" />
            </MenuItem>
            <MenuItem Header="_Sesja">
                <MenuItem Header="_Lista sesji…" InputGestureText="Ctrl+0" Click="Sessions_Click" />
                <MenuItem Header="Poprzednia sesja" InputGestureText="Ctrl+Page Up" Click="PreviousSession_Click" />
                <MenuItem Header="Następna sesja" InputGestureText="Ctrl+Page Down" Click="NextSession_Click" />
            </MenuItem>
            <MenuItem Header="_Odtwarzanie">
                <MenuItem Header="Skocz do _czasu…" InputGestureText="Ctrl+J"
                          automation:AutomationProperties.Name="Skocz do czasu, Ctrl+J, tylko w odtwarzaczu"
                          automation:AutomationProperties.AcceleratorKey="Ctrl+J"
                          Click="SeekToTime_Click" />
                <MenuItem Header="Skocz do _procentu…" InputGestureText="Ctrl+Shift+J"
                          automation:AutomationProperties.Name="Skocz do procentu, Ctrl+Shift+J, tylko w odtwarzaczu"
                          automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+J"
                          Click="SeekToPercentage_Click" />
                <Separator />
                <MenuItem Header="_Wolniej" InputGestureText="Shift+,"
                          automation:AutomationProperties.Name="Zmniejsz prędkość odtwarzania, Shift+przecinek, w odtwarzaczu"
                          automation:AutomationProperties.AcceleratorKey="Shift+,"
                          Click="PlaybackRateDown_Click" />
                <MenuItem Header="_Szybciej" InputGestureText="Shift+."
                          automation:AutomationProperties.Name="Zwiększ prędkość odtwarzania, Shift+kropka, w odtwarzaczu"
                          automation:AutomationProperties.AcceleratorKey="Shift+."
                          Click="PlaybackRateUp_Click" />
                <MenuItem Header="Prędkość _normalna" InputGestureText="Ctrl+."
                          automation:AutomationProperties.Name="Przywróć normalną prędkość odtwarzania, Ctrl+kropka, w odtwarzaczu"
                          automation:AutomationProperties.AcceleratorKey="Ctrl+."
                          Click="PlaybackRateReset_Click" />
                <Separator />
                <MenuItem Header="_Właściwości i informacje" InputGestureText="Alt+Enter"
                          automation:AutomationProperties.AcceleratorKey="Alt+Enter"
                          Click="Information_Click" />
            </MenuItem>
            <MenuItem Header="_Widok">
                <MenuItem Header="_Teraz odtwarzane" InputGestureText="F6"
                          automation:AutomationProperties.AcceleratorKey="F6" Click="NowPlayingView_Click" />
                <MenuItem Header="_Ulubione" InputGestureText="Ctrl+U" Click="FavoritesView_Click" />
                <MenuItem Header="_Playlisty" InputGestureText="Ctrl+P" Click="PlaylistsView_Click" />
                <MenuItem Header="_Biblioteka" InputGestureText="Ctrl+L" Click="LibraryView_Click" />
                <MenuItem Header="_Albumy" InputGestureText="Ctrl+Shift+A" Click="AlbumsView_Click" />
                <MenuItem Header="_Kolejka" InputGestureText="Ctrl+Q" Click="QueueView_Click" />
                <Separator />
                <MenuItem Header="_Filtruj listę" InputGestureText="Ctrl+K" Click="Filter_Click" />
                <MenuItem Header="_Szukaj w bieżącej usłudze" InputGestureText="Ctrl+F" Click="SearchCurrent_Click" />
                <MenuItem Header="Szukaj _globalnie" InputGestureText="Ctrl+Shift+F" Click="SearchAll_Click" />
                <MenuItem Header="_Paleta poleceń" InputGestureText="Ctrl+Shift+K" Click="CommandPalette_Click" />
            </MenuItem>
            <MenuItem Header="_Pomoc">
                <MenuItem Header="_Skróty prototypu" InputGestureText="F1" Click="Help_Click" />
                <MenuItem Header="Sprawdź _aktualizacje" Click="Updates_Click" />
            </MenuItem>
        </Menu>

        <StackPanel x:Name="BrowserHeaderPanel" DockPanel.Dock="Top">
            <TextBlock x:Name="SessionHeading" FontSize="20" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1"
                       automation:AutomationProperties.Name="Bieżąca sesja" />
            <TextBlock x:Name="ViewHeading" Margin="0,4,0,10" FontSize="15"
                       automation:AutomationProperties.HeadingLevel="Level2" />
            <Label Target="{Binding ElementName=FilterBox}" Padding="0,0,0,3">_Filtruj listę:</Label>
            <TextBox x:Name="FilterBox" Margin="0,0,0,8"
                     automation:AutomationProperties.Name="Filtruj listę"
                     TextChanged="FilterBox_TextChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel x:Name="BrowserActionPanel" Margin="0,8,0,8">
                <Button MinWidth="175" Margin="0,0,8,0" Content="Odtwórz lub _wstrzymaj" Click="ToggleSelectedPlayback_Click" />
                <Button MinWidth="175" Margin="0,0,8,0" Content="Zmień stan _ulubionych" Click="Favorite_Click" />
                <Button MinWidth="145" Margin="0,0,8,0" Content="Zmień _playlisty…" Click="Playlists_Click" />
                <Button MinWidth="120" Content="U_stawienia…" Click="Settings_Click" />
            </WrapPanel>
            <Border BorderThickness="1" BorderBrush="Gray" Padding="6">
                <controls:AccessibleStatusTextBlock x:Name="StatusText"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    Text="Gotowy" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid>
        <ListBox x:Name="MediaList"
                 SelectionMode="Extended"
                 ItemsSource="{Binding}"
                 DisplayMemberPath="Label"
                 IsTextSearchEnabled="False"
                 TextSearch.TextPath="NavigationText"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 KeyboardNavigation.TabNavigation="Once"
                 SelectionChanged="MediaList_SelectionChanged"
                 PreviewKeyDown="MediaList_PreviewKeyDown"
                 PreviewTextInput="MediaList_PreviewTextInput"
                 MouseDoubleClick="MediaList_MouseDoubleClick">
            <ListBox.ContextMenu>
                <ContextMenu Opened="MediaContextMenu_Opened" Closed="MediaContextMenu_Closed">
                    <MenuItem x:Name="PlaybackMenuItem" Header="Odtwórz lub wstrzymaj" InputGestureText="Ctrl+Enter"
                              automation:AutomationProperties.Name="Odtwórz lub wstrzymaj, Ctrl+Enter"
                              Click="ToggleSelectedPlayback_Click" />
                    <MenuItem x:Name="PlayNextMenuItem" Header="Odtwórz jako następne" InputGestureText="Ctrl+Shift+Enter"
                              automation:AutomationProperties.Name="Odtwórz jako następne, Ctrl+Shift+Enter"
                              Click="PlayNext_Click" />
                    <MenuItem x:Name="QueueMenuItem" Header="Dodaj do kolejki" InputGestureText="Shift+Enter"
                              automation:AutomationProperties.Name="Dodaj do kolejki, Shift+Enter"
                              Click="Queue_Click" />
                    <Separator />
                    <MenuItem x:Name="FavoriteMenuItem" Header="Dodaj do ulubionych" InputGestureText="Ctrl+Shift+U"
                              automation:AutomationProperties.Name="Dodaj do ulubionych, Ctrl+Shift+U"
                              Click="Favorite_Click" />
                    <MenuItem x:Name="LibraryMenuItem" Header="Dodaj do biblioteki" InputGestureText="Ctrl+Shift+L"
                              automation:AutomationProperties.Name="Dodaj do biblioteki, Ctrl+Shift+L"
                              Click="Library_Click" />
                    <MenuItem Header="Zmień przynależność do playlist…" InputGestureText="Ctrl+Shift+P"
                              automation:AutomationProperties.Name="Zmień przynależność do playlist, Ctrl+Shift+P"
                              Click="Playlists_Click" />
                    <Separator />
                    <MenuItem Header="Właściwości i informacje" InputGestureText="Alt+Enter"
                              automation:AutomationProperties.Name="Właściwości i informacje, Alt+Enter"
                              Click="Information_Click" />
                    <MenuItem Header="Kopiuj nazwę" InputGestureText="Ctrl+C"
                              automation:AutomationProperties.Name="Kopiuj nazwę, Ctrl+C"
                              Click="CopyName_Click" />
                    <MenuItem x:Name="CopyLocationMenuItem" Header="Kopiuj ścieżkę lub łącze" InputGestureText="Ctrl+Shift+C"
                              automation:AutomationProperties.Name="Kopiuj ścieżkę lub łącze, Ctrl+Shift+C"
                              Click="CopyLocation_Click" />
                    <MenuItem Header="Otwórz w oficjalnej aplikacji" Click="OfficialApp_Click" />
                    <MenuItem Header="Usuń z bieżącego widoku" InputGestureText="Delete"
                              automation:AutomationProperties.Name="Usuń z bieżącego widoku, Delete"
                              Click="Remove_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <Border x:Name="PlayerPanel" Visibility="Collapsed"
                BorderThickness="1" BorderBrush="Gray" Padding="18"
                automation:AutomationProperties.Name="Odtwarzacz">
            <Border.ContextMenu>
                <ContextMenu Opened="PlayerContextMenu_Opened">
                    <MenuItem x:Name="PlayerPlayPauseMenuItem" Header="Odtwórz lub wstrzymaj" InputGestureText="Spacja"
                              automation:AutomationProperties.Name="Odtwórz lub wstrzymaj, Spacja"
                              Click="PlayerPlayPause_Click" />
                    <MenuItem x:Name="PlayerPlayNextMenuItem" Header="Odtwórz jako następne" InputGestureText="Ctrl+Shift+Enter"
                              automation:AutomationProperties.Name="Odtwórz jako następne, Ctrl+Shift+Enter"
                              Click="PlayNext_Click" />
                    <MenuItem x:Name="PlayerQueueMenuItem" Header="Dodaj do kolejki" InputGestureText="Shift+Enter"
                              automation:AutomationProperties.Name="Dodaj do kolejki, Shift+Enter"
                              Click="Queue_Click" />
                    <Separator />
                    <MenuItem x:Name="PlayerFavoriteMenuItem" Header="Dodaj do ulubionych" InputGestureText="Ctrl+Shift+U"
                              automation:AutomationProperties.Name="Dodaj do ulubionych, Ctrl+Shift+U"
                              Click="Favorite_Click" />
                    <MenuItem x:Name="PlayerLibraryMenuItem" Header="Dodaj do biblioteki" InputGestureText="Ctrl+Shift+L"
                              automation:AutomationProperties.Name="Dodaj do biblioteki, Ctrl+Shift+L"
                              Click="Library_Click" />
                    <MenuItem Header="Zmień przynależność do playlist…" InputGestureText="Ctrl+Shift+P"
                              automation:AutomationProperties.Name="Zmień przynależność do playlist, Ctrl+Shift+P"
                              Click="Playlists_Click" />
                    <Separator />
                    <MenuItem Header="Właściwości i informacje" InputGestureText="Alt+Enter"
                              automation:AutomationProperties.Name="Właściwości i informacje, Alt+Enter"
                              Click="Information_Click" />
                    <MenuItem Header="Kopiuj nazwę" InputGestureText="Ctrl+C"
                              automation:AutomationProperties.Name="Kopiuj nazwę, Ctrl+C"
                              Click="CopyName_Click" />
                    <MenuItem x:Name="PlayerCopyLocationMenuItem" Header="Kopiuj ścieżkę lub łącze" InputGestureText="Ctrl+Shift+C"
                              automation:AutomationProperties.Name="Kopiuj ścieżkę lub łącze, Ctrl+Shift+C"
                              Click="CopyLocation_Click" />
                    <MenuItem Header="Otwórz w oficjalnej aplikacji" Click="OfficialApp_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
                <TextBlock Text="Odtwarzacz" FontSize="20" FontWeight="SemiBold"
                           automation:AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="PlayerTitleText" Margin="0,14,0,0" FontSize="24"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="PlayerArtistText" Margin="0,5,0,0" FontSize="16"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PlayerSessionText" Margin="0,5,0,0" />
                <TextBlock x:Name="PlayerStateText" Margin="0,12,0,0" FontWeight="SemiBold" />
                <TextBlock x:Name="PlayerSpeedText" Margin="0,4,0,0" />
                <TextBlock x:Name="PlayerTimeText" Margin="0,4,0,14" FontSize="16" />
                <WrapPanel>
                    <Button x:Name="PlayerPlayPauseButton" MinWidth="145" Margin="0,0,8,8"
                            Content="_Odtwórz" Click="PlayerPlayPause_Click" />
                    <Button MinWidth="135" Margin="0,0,8,8" Content="_Cofnij 10 sekund"
                            Click="PlayerBackward_Click" />
                    <Button MinWidth="145" Margin="0,0,8,8" Content="_Przewiń 10 sekund"
                            Click="PlayerForward_Click" />
                    <Button MinWidth="125" Margin="0,0,8,8" Content="_Ciszej"
                            Click="PlayerVolumeDown_Click" />
                    <Button MinWidth="125" Margin="0,0,8,8" Content="_Głośniej"
                            Click="PlayerVolumeUp_Click" />
                    <Button MinWidth="125" Margin="0,0,8,8" Content="_Wolniej"
                            automation:AutomationProperties.AcceleratorKey="Shift+,"
                            Click="PlaybackRateDown_Click" />
                    <Button MinWidth="125" Margin="0,0,8,8" Content="_Szybciej"
                            automation:AutomationProperties.AcceleratorKey="Shift+."
                            Click="PlaybackRateUp_Click" />
                    <Button MinWidth="165" Margin="0,0,8,8" Content="Prędkość _normalna"
                            automation:AutomationProperties.AcceleratorKey="Ctrl+."
                            Click="PlaybackRateReset_Click" />
                    <Button MinWidth="145" Margin="0,0,8,8" Content="Skocz do _czasu…"
                            automation:AutomationProperties.AcceleratorKey="Ctrl+J"
                            Click="SeekToTime_Click" />
                    <Button MinWidth="155" Margin="0,0,8,8" Content="Skocz do _procentu…"
                            automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+J"
                            Click="SeekToPercentage_Click" />
                    <Button MinWidth="145" Margin="0,0,8,8" Content="_Wróć do listy"
                            Click="PlayerBack_Click" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Strzałki sterują czasem i głośnością. Shift+przecinek zwalnia, Shift+kropka przyspiesza, Ctrl+kropka przywraca normalną prędkość. Spacja wstrzymuje lub wznawia. Escape wraca do listy." />
            </StackPanel>
        </Border>
        </Grid>
        </DockPanel>
    </DockPanel>
</controls:AccessibleWindow>
