<Window x:Class="AccessibleMediaController.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Dostępny kontroler multimedialny — prototyp"
        Width="820" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <DockPanel Margin="12">
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Margin="0,0,0,8"
              KeyboardNavigation.IsTabStop="False"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Ustawienia…" InputGestureText="Ctrl+," Click="Settings_Click" />
                <Separator />
                <MenuItem Header="_Zakończ" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edycja">
                <MenuItem Header="_Cofnij ostatnią zmianę" InputGestureText="Ctrl+Z" Click="Undo_Click" />
            </MenuItem>
            <MenuItem Header="_Sesja">
                <MenuItem Header="_Lista sesji…" InputGestureText="Ctrl+0" Click="Sessions_Click" />
                <MenuItem Header="Poprzednia sesja" InputGestureText="Ctrl+Page Up" Click="PreviousSession_Click" />
                <MenuItem Header="Następna sesja" InputGestureText="Ctrl+Page Down" Click="NextSession_Click" />
            </MenuItem>
            <MenuItem Header="_Widok">
                <MenuItem Header="_Teraz odtwarzane" Click="NowPlayingView_Click" />
                <MenuItem Header="_Ulubione" InputGestureText="Ctrl+U" Click="FavoritesView_Click" />
                <MenuItem Header="_Playlisty" InputGestureText="Ctrl+P" Click="PlaylistsView_Click" />
                <MenuItem Header="_Biblioteka" InputGestureText="Ctrl+L" Click="LibraryView_Click" />
                <MenuItem Header="_Albumy" InputGestureText="Ctrl+Shift+A" Click="AlbumsView_Click" />
                <MenuItem Header="_Kolejka" InputGestureText="Ctrl+Q" Click="QueueView_Click" />
                <Separator />
                <MenuItem Header="_Filtruj listę" InputGestureText="Ctrl+K" Click="Filter_Click" />
                <MenuItem Header="_Szukaj w bieżącej usłudze" InputGestureText="Ctrl+F" Click="SearchCurrent_Click" />
                <MenuItem Header="Szukaj _globalnie" InputGestureText="Ctrl+Shift+F" Click="SearchAll_Click" />
                <MenuItem Header="_Paleta poleceń" InputGestureText="Ctrl+Shift+K" Click="CommandPalette_Click" />
            </MenuItem>
            <MenuItem Header="_Pomoc">
                <MenuItem Header="_Skróty prototypu" InputGestureText="F1" Click="Help_Click" />
                <MenuItem Header="Sprawdź _aktualizacje" Click="Updates_Click" />
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="SessionHeading" FontSize="20" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1"
                       automation:AutomationProperties.Name="Bieżąca sesja" />
            <TextBlock x:Name="ViewHeading" Margin="0,4,0,10" FontSize="15"
                       automation:AutomationProperties.HeadingLevel="Level2" />
            <Label Target="{Binding ElementName=FilterBox}" Padding="0,0,0,3">_Filtruj listę:</Label>
            <TextBox x:Name="FilterBox" Margin="0,0,0,8"
                     automation:AutomationProperties.Name="Filtruj listę"
                     TextChanged="FilterBox_TextChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel Margin="0,8,0,8">
                <Button MinWidth="105" Margin="0,0,8,0" Content="_Odtwórz" Click="Play_Click" />
                <Button MinWidth="175" Margin="0,0,8,0" Content="Zmień stan _ulubionych" Click="Favorite_Click" />
                <Button MinWidth="145" Margin="0,0,8,0" Content="Zmień _playlisty…" Click="Playlists_Click" />
                <Button MinWidth="120" Content="U_stawienia…" Click="Settings_Click" />
            </WrapPanel>
            <Border BorderThickness="1" BorderBrush="Gray" Padding="6">
                <controls:AccessibleStatusTextBlock x:Name="StatusText"
                    automation:AutomationProperties.Name="Stan programu"
                    automation:AutomationProperties.LiveSetting="Assertive"
                    Text="Gotowy" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ListBox x:Name="MediaList"
                 ItemsSource="{Binding}"
                 DisplayMemberPath="Label"
                 IsTextSearchEnabled="False"
                 TextSearch.TextPath="NavigationText"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 KeyboardNavigation.TabNavigation="Once"
                 SelectionChanged="MediaList_SelectionChanged"
                 PreviewKeyDown="MediaList_PreviewKeyDown"
                 PreviewTextInput="MediaList_PreviewTextInput"
                 MouseDoubleClick="MediaList_MouseDoubleClick">
            <ListBox.ContextMenu>
                <ContextMenu Opened="MediaContextMenu_Opened" Closed="MediaContextMenu_Closed">
                    <MenuItem Header="Odtwórz teraz" InputGestureText="Ctrl+Enter"
                              automation:AutomationProperties.AcceleratorKey="Ctrl+Enter" Click="Play_Click" />
                    <MenuItem x:Name="PlayNextMenuItem" Header="Odtwórz jako następne" InputGestureText="Ctrl+Shift+Enter"
                              automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+Enter" Click="PlayNext_Click" />
                    <MenuItem x:Name="QueueMenuItem" Header="Dodaj do kolejki" InputGestureText="Shift+Enter"
                              automation:AutomationProperties.AcceleratorKey="Shift+Enter" Click="Queue_Click" />
                    <Separator />
                    <MenuItem Header="Dodaj do ulubionych lub usuń" InputGestureText="Ctrl+Shift+U"
                              automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+U" Click="Favorite_Click" />
                    <MenuItem Header="Zmień przynależność do playlist…" InputGestureText="Ctrl+Shift+P"
                              automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+P" Click="Playlists_Click" />
                    <Separator />
                    <MenuItem Header="Informacje" InputGestureText="Alt+Enter"
                              automation:AutomationProperties.AcceleratorKey="Alt+Enter" Click="Information_Click" />
                    <MenuItem Header="Otwórz w oficjalnej aplikacji" InputGestureText="Ctrl+Shift+O"
                              automation:AutomationProperties.AcceleratorKey="Ctrl+Shift+O" Click="OfficialApp_Click" />
                    <MenuItem Header="Usuń z bieżącego widoku" InputGestureText="Delete"
                              automation:AutomationProperties.AcceleratorKey="Delete" Click="Remove_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</Window>
