<Window x:Class="AccessibleMediaController.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Ustawienia" Width="760" Height="610" MinWidth="660" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ContentRendered="Window_ContentRendered"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="105" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Save_Click" />
            <Button Width="105" Content="_Anuluj" IsCancel="True" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs" automation:AutomationProperties.Name="Kategorie ustawień">
            <TabItem x:Name="GeneralTab" Header="_Ogólne">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Tutaj znajdują się podstawowe ustawienia działającego prototypu. Funkcje planowane są wyraźnie oznaczone i nie można ich jeszcze zmieniać." />
                    <Label Target="{Binding ElementName=LanguageText}">_Język interfejsu:</Label>
                    <TextBox x:Name="LanguageText" Margin="0,0,0,12" IsReadOnly="True"
                             Text="Polski — zmiana języka jest planowana"
                             automation:AutomationProperties.Name="Język interfejsu"
                             automation:AutomationProperties.HelpText="Obecnie dostępny jest język polski." />
                    <Label Target="{Binding ElementName=StartupTargetCombo}">_Wyświetlaj po uruchomieniu:</Label>
                    <ComboBox x:Name="StartupTargetCombo" Margin="0,0,0,12" SelectedIndex="0"
                               automation:AutomationProperties.Name="Wyświetlaj po uruchomieniu">
                        <ComboBoxItem Tag="MediaList">Ostatnia używana sesja</ComboBoxItem>
                        <ComboBoxItem Tag="SessionList">Lista sesji</ComboBoxItem>
                    </ComboBox>
                    <GroupBox Header="Odtwarzanie" Margin="0,2,0,14">
                        <StackPanel Margin="8">
                            <CheckBox x:Name="PausePlaybackWhenLeavingPlayerCheck" Margin="0,0,0,8"
                                      Content="_Wstrzymuj odtwarzanie po wyjściu z odtwarzacza"
                                      automation:AutomationProperties.HelpText="Dotyczy Escape, Shift+F6, przycisku Wróć do listy i bezpośredniego przejścia do innego widoku. Zwykła lista zachowuje zwykłe działanie klawiszy." />
                            <CheckBox x:Name="RememberLocalPlaybackPositionsCheck"
                                      Content="_Pamiętaj pozycję odtwarzania lokalnych plików"
                                      automation:AutomationProperties.HelpText="To ustawienie globalne. Dla każdego Folderu Biblioteki oraz pojedynczego elementu można wybrać inne zachowanie." />
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Kolejność sesji i skróty Ctrl+1–9" Margin="0,2,0,14">
                        <StackPanel Margin="8">
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                                       Text="Kolejność na tej liście określa skróty Ctrl+1–9 oraz przechodzenie przez sesje skrótami Ctrl+Page Up i Ctrl+Page Down." />
                            <ListBox x:Name="SessionOrderList" Height="120" DisplayMemberPath="Label"
                                     TextSearch.TextPath="DisplayName"
                                     automation:AutomationProperties.Name="Kolejność sesji i skrótów Control od 1 do 9"
                                     automation:AutomationProperties.HelpText="Alt+Strzałka w górę lub w dół zmienia położenie zaznaczonej sesji."
                                     PreviewKeyDown="SessionOrderList_PreviewKeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <WrapPanel Margin="0,8,0,0">
                                <Button MinWidth="105" Margin="0,0,8,8" Content="Przenieś _wyżej" Click="MoveSessionUp_Click" />
                                <Button MinWidth="105" Margin="0,0,8,8" Content="Przenieś _niżej" Click="MoveSessionDown_Click" />
                                <Button MinWidth="155" Margin="0,0,8,8" Content="Przywróć _domyślną" Click="RestoreSessionOrder_Click" />
                            </WrapPanel>
                            <controls:AccessibleStatusTextBlock x:Name="SessionOrderStatus" Margin="0,2,0,0"
                                automation:AutomationProperties.Name="Wynik zmiany kolejności sesji"
                                automation:AutomationProperties.LiveSetting="Assertive"
                                Text="Gotowy do zmiany kolejności sesji" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                    <TextBlock Margin="0,4,0,6" FontWeight="SemiBold" Text="Prefiks globalny" />
                    <Label Target="{Binding ElementName=PrefixBox}">Globalny _prefiks:</Label>
                    <TextBox x:Name="PrefixBox" Margin="0,0,0,12"
                             automation:AutomationProperties.HelpText="Domyślnie: Ctrl+Alt+Windows+F12" />
                    <Label Target="{Binding ElementName=TimeoutBox}">_Czas na następny klawisz po prefiksie:</Label>
                    <TextBox x:Name="TimeoutBox" Width="180" HorizontalAlignment="Left"
                             automation:AutomationProperties.Name="Czas na następny klawisz po prefiksie, w milisekundach"
                             automation:AutomationProperties.HelpText="3000 milisekund oznacza 3 sekundy." />
                    <TextBlock Margin="0,4,0,0" Text="Wartość jest podawana w milisekundach; 3000 oznacza 3 sekundy."
                               TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="KeyboardProfilesTab" Header="_Profile klawiatury">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="Profil wbudowany jest tylko do odczytu. Zmiana przypisania automatycznie utworzy jego edytowalną kopię." />
                        <Label Target="{Binding ElementName=ProfileCombo}">_Profil:</Label>
                        <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="ProfileCombo_SelectionChanged" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="ActivateProfileButton" Margin="0,0,8,8" Content="_Aktywuj" Click="ActivateProfile_Click" />
                            <Button x:Name="DuplicateProfileButton" Margin="0,0,8,8" Content="Utwórz _kopię…" Click="DuplicateProfile_Click" />
                            <Button x:Name="RenameProfileButton" Margin="0,0,8,8" Content="Zmień _nazwę…" Click="RenameProfile_Click" />
                            <Button x:Name="DeleteProfileButton" Margin="0,0,8,8" Content="_Usuń profil" Click="DeleteProfile_Click" />
                            <Button x:Name="ImportKeyboardMapButton" Margin="0,0,8,8" Content="_Importuj mapę…" Click="ImportKeyboardMap_Click" />
                            <Button x:Name="ExportKeyboardMapButton" Margin="0,0,8,8" Content="_Eksportuj mapę…" Click="ExportKeyboardMap_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ActiveProfileText" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button x:Name="ChangeBindingButton" Margin="0,0,8,0" Content="_Zmień skrót…" Click="ChangeBinding_Click" />
                        <Button x:Name="RemoveBindingButton" Content="Usuń _przypisanie" Click="RemoveBinding_Click" />
                    </StackPanel>
                    <ListBox x:Name="BindingsList" DisplayMemberPath="Label"
                             automation:AutomationProperties.Name="Przypisania wybranego profilu" />
                </DockPanel>
            </TabItem>

            <TabItem x:Name="ImportExportTab" Header="_Import i eksport">
                <StackPanel Margin="12">
                    <TextBlock FontWeight="SemiBold" Text="Konfiguracja bez map klawiszy" />
                    <WrapPanel Margin="0,8,0,18">
                        <Button x:Name="ImportConfigurationButton" Margin="0,0,8,0" Content="Importuj _konfigurację…" Click="ImportConfiguration_Click" />
                        <Button x:Name="ExportConfigurationButton" Content="Eksportuj k_onfigurację…" Click="ExportConfiguration_Click" />
                    </WrapPanel>
                    <TextBlock FontWeight="SemiBold" Text="Pełna kopia danych AMC" />
                    <WrapPanel Margin="0,8,0,18">
                        <Button x:Name="ImportFullBackupButton" Margin="0,0,8,0" Content="Importuj pełną _kopię…" Click="ImportFullBackup_Click" />
                        <Button x:Name="ExportFullBackupButton" Content="Eksportuj _wszystko…" Click="ExportFullBackup_Click" />
                    </WrapPanel>
                    <TextBlock TextWrapping="Wrap"
                               Text="Pełna kopia obejmuje katalog Biblioteki lokalnej, Foldery Biblioteki, wykluczenia, Ulubione, kolejki, historię, zakładki, zapamiętane pozycje, ustawienia, profile klawiatury i kolejność sesji. Hasła, tokeny oraz dane logowania nigdy nie są eksportowane." />
                </StackPanel>
            </TabItem>

            <TabItem x:Name="MessagesTab" Header="_Komunikaty">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Odczytywanie elementów list" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="Ustaw kolejność informacji odczytywanych dla każdego elementu listy. Pola bez wartości są pomijane." />
                                <ListBox x:Name="ListFieldOrderList" Height="115" DisplayMemberPath="Label"
                                          automation:AutomationProperties.Name="Kolejność informacji o elemencie"
                                          automation:AutomationProperties.HelpText="Alt+Strzałka w górę lub w dół zmienia położenie zaznaczonego pola."
                                          SelectionChanged="ListFieldOrderList_SelectionChanged"
                                          PreviewKeyDown="ListFieldOrderList_PreviewKeyDown" />
                                <Border Margin="0,8,0,0" BorderThickness="1" BorderBrush="Gray" Padding="8">
                                    <TextBox x:Name="ListFieldPreviewText" Padding="0" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                             automation:AutomationProperties.Name="Podgląd kolejności odczytu" />
                                </Border>
                                <WrapPanel Margin="0,8,0,4">
                                    <Button MinWidth="105" Margin="0,0,8,8" Content="_Wyżej" Click="MoveFieldUp_Click" />
                                    <Button MinWidth="105" Margin="0,0,8,8" Content="_Niżej" Click="MoveFieldDown_Click" />
                                    <Button MinWidth="155" Margin="0,0,8,8" Content="Przywróć _domyślną" Click="RestoreFieldOrder_Click" />
                                </WrapPanel>
                                <controls:AccessibleStatusTextBlock x:Name="ListOrderStatus"
                                    automation:AutomationProperties.Name="Wynik zmiany kolejności"
                                    automation:AutomationProperties.LiveSetting="Assertive"
                                    Text="Gotowy do zmiany kolejności" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Komunikaty dostępności">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="MessagesEnabledCheck" Margin="0,0,0,10" Content="_Włącz komunikaty dostępności" />
                                <CheckBox x:Name="DetailedHintsCheck" Margin="0,0,0,10"
                                          Content="Pokazuj _szczegółowe podpowiedzi klawiatury przy polach i listach" />
                                <CheckBox x:Name="SeekMessagesCheck" Margin="0,0,0,10"
                                          Content="Włącz _automatyczne komunikaty odtwarzacza" />
                                <CheckBox x:Name="HistoryMessagesCheck" Margin="0,0,0,10"
                                          Content="Oznajmiaj kierunek _historii widoków" />
                                <CheckBox x:Name="PercentageSeekMessagesCheck" Margin="18,0,0,6" Content="Oznajmiaj skoki _cyframi" />
                                <CheckBox x:Name="ArrowSeekMessagesCheck" Margin="18,0,0,6" Content="Oznajmiaj przewijanie _strzałkami, Home i End" />
                                <CheckBox x:Name="BookmarkNavigationMessagesCheck" Margin="18,0,0,6" Content="Oznajmiaj nawigację po _zakładkach" />
                                <CheckBox x:Name="VolumeMessagesCheck" Margin="18,0,0,6" Content="Oznajmiaj zmiany _głośności" />
                                <CheckBox x:Name="PlaybackMessagesCheck" Margin="18,0,0,8" Content="Oznajmiaj _odtwarzanie i pauzę" />
                                <Label Target="{Binding ElementName=PercentageSeekAnnouncementCombo}">Po skoku _cyfrą oznajmiaj:</Label>
                                <ComboBox x:Name="PercentageSeekAnnouncementCombo" Width="260" HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="Percent">Tylko procent</ComboBoxItem>
                                    <ComboBoxItem Tag="Time">Tylko czas</ComboBoxItem>
                                    <ComboBoxItem Tag="PercentAndTime">Procent i czas</ComboBoxItem>
                                </ComboBox>
                                <TextBlock Margin="0,12,0,8" TextWrapping="Wrap"
                                           Text="Wybierz zdarzenie z listy, a następnie zmień jego tekst. Pusty tekst wyłącza dany komunikat." />
                                <Label Target="{Binding ElementName=MessageTemplatesList}">_Zdarzenie:</Label>
                                <ListBox x:Name="MessageTemplatesList" Height="130" DisplayMemberPath="EventLabel"
                                         automation:AutomationProperties.Name="Zdarzenia komunikatów" />
                                <Label Margin="0,8,0,0" Target="{Binding ElementName=MessageTemplateText}">_Tekst szablonu:</Label>
                                <TextBox x:Name="MessageTemplateText" MinHeight="42" TextWrapping="Wrap"
                                         Text="{Binding SelectedItem.Template, ElementName=MessageTemplatesList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Tekst szablonu wybranego komunikatu" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="UpdatesTab" Header="_Aktualizacje (planowane)">
                <StackPanel Margin="12">
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontWeight="SemiBold"
                               Text="Ta sekcja jest makietą następnego etapu. Serwer aktualizacji nie jest jeszcze skonfigurowany, dlatego poniższe opcje są nieaktywne." />
                    <StackPanel IsEnabled="False">
                        <CheckBox x:Name="UpdateCheckAutomatically" Margin="0,0,0,8"
                                  Content="Automatycznie _sprawdzaj aktualizacje w tle" />
                        <CheckBox x:Name="UpdateDownloadAutomatically" Margin="0,0,0,8"
                                  Content="Automatycznie _pobieraj podpisane pakiety" />
                        <CheckBox x:Name="UpdateInstallOnExit" Margin="0,0,0,8"
                                  Content="Instaluj przy _zamykaniu lub następnym uruchomieniu" />
                        <CheckBox x:Name="UpdateMetered" Margin="0,0,0,12"
                                  Content="Zezwalaj na pobieranie przez połączenia _taryfowe" />
                        <Label Target="{Binding ElementName=UpdateChannelCombo}">_Kanał aktualizacji:</Label>
                        <ComboBox x:Name="UpdateChannelCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Tag="stable">Stabilny</ComboBoxItem>
                            <ComboBoxItem Tag="beta">Beta</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                               Text="Docelowe pakiety będą podpisywane, sprawdzane i instalowane z możliwością wycofania." />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
