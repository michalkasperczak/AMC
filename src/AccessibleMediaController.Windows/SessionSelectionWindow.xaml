<Window x:Class="AccessibleMediaController.Windows.SessionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Wybór sesji" Width="460" Height="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Text="Wybierz sesję"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <controls:AccessibleStatusTextBlock x:Name="SessionOrderStatus" Margin="0,0,0,8"
                automation:AutomationProperties.Name="Wynik zmiany kolejności sesji"
                automation:AutomationProperties.LiveSetting="Assertive"
                Text="Alt+Strzałka w górę lub w dół zmienia kolejność sesji" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="95" Margin="0,0,8,0" Content="_Wybierz" IsDefault="True" Click="Select_Click" />
                <Button Width="95" Content="_Anuluj" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="SessionList" DisplayMemberPath="Label" TextSearch.TextPath="Name"
                 automation:AutomationProperties.Name="Sesje"
                 automation:AutomationProperties.HelpText="Alt+Strzałka w górę lub w dół zmienia położenie zaznaczonej sesji i jej skrót Ctrl+cyfra."
                 PreviewKeyDown="SessionList_PreviewKeyDown"
                 MouseDoubleClick="SessionList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
