<Window x:Class="AccessibleMediaController.Windows.ItemPlaybackOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Opcje odtwarzania elementu" Width="650" Height="700"
        MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ItemTitleText" Margin="0,0,0,14" FontSize="18"
                   FontWeight="SemiBold" TextWrapping="Wrap"
                   automation:AutomationProperties.HeadingLevel="Level1" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">
                <Label x:Name="ResumeModeLabel" Target="{Binding ElementName=ResumeModeBox}">_Pozycja odtwarzania:</Label>
                <ComboBox x:Name="ResumeModeBox" Margin="0,0,0,14"
                          DisplayMemberPath="Label" TextSearch.TextPath="Label"
                          automation:AutomationProperties.Name="Pozycja odtwarzania"
                          automation:AutomationProperties.HelpText="Wybierz ustawienie dla tego pliku albo dziedziczenie z folderu i ustawień globalnych." />

                <Label x:Name="PlaybackRateLabel" Target="{Binding ElementName=PlaybackRateBox}">_Prędkość tego elementu:</Label>
                <ComboBox x:Name="PlaybackRateBox" Margin="0,0,0,14"
                          DisplayMemberPath="Label" TextSearch.TextPath="Label"
                          automation:AutomationProperties.Name="Prędkość tego elementu"
                          automation:AutomationProperties.HelpText="1,00 razy oznacza normalną prędkość; mniejsze wartości są wolniejsze, a większe szybsze." />

                <Label x:Name="LoudnessNormalizationLabel" Target="{Binding ElementName=LoudnessNormalizationBox}">_Normalizacja głośności:</Label>
                <ComboBox x:Name="LoudnessNormalizationBox" Margin="0,0,0,14"
                          DisplayMemberPath="Label" TextSearch.TextPath="Label"
                          automation:AutomationProperties.Name="Normalizacja głośności"
                          automation:AutomationProperties.HelpText="Może dziedziczyć ustawienie folderu lub ustawienie globalne, albo zostać włączona lub wyłączona tylko tutaj." />

                <Label x:Name="SmoothTransitionsLabel" Target="{Binding ElementName=SmoothTransitionsBox}">_Łagodne przejścia:</Label>
                <ComboBox x:Name="SmoothTransitionsBox" Margin="0,0,0,14"
                          DisplayMemberPath="Label" TextSearch.TextPath="Label"
                          automation:AutomationProperties.Name="Łagodne przejścia"
                          automation:AutomationProperties.HelpText="Może dziedziczyć ustawienie folderu lub ustawienie globalne, albo zostać włączone lub wyłączone tylko tutaj." />

                <Label x:Name="InterTrackSilenceLabel" Target="{Binding ElementName=InterTrackSilenceBox}">_Cisza po tym elemencie:</Label>
                <ComboBox x:Name="InterTrackSilenceBox" Margin="0,0,0,14"
                          DisplayMemberPath="Label" TextSearch.TextPath="Label"
                          automation:AutomationProperties.Name="Cisza po tym elemencie"
                          automation:AutomationProperties.HelpText="Określa dodatkową ciszę po zakończeniu tego pliku przed automatycznym uruchomieniem następnego." />

                <Label x:Name="OutputDeviceLabel" Target="{Binding ElementName=OutputDeviceBox}">_Urządzenie audio dla elementu:</Label>
                <ComboBox x:Name="OutputDeviceBox" Margin="0,0,0,6" IsEnabled="False"
                          automation:AutomationProperties.Name="Urządzenie audio dla elementu"
                          automation:AutomationProperties.HelpText="Wybór urządzenia zostanie włączony po dodaniu listy wyjść audio." />
                <TextBlock Margin="0,0,0,16" TextWrapping="Wrap"
                           Text="Obecnie AMC używa bezpiecznego, współdzielonego domyślnego wyjścia Windows. Miejsce dla urządzenia elementu jest już wydzielone; wybór oraz EQ dojdą wraz z modułem wyjść audio." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="105" Margin="0,0,8,0" Content="_Zapisz" IsDefault="True" Click="Save_Click" />
            <Button Width="105" Content="_Anuluj" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
