<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.TidalAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Konto i synchronizacja TIDAL" Width="740" Height="570"
        MinWidth="600" MinHeight="500" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Konto i synchronizacja TIDAL" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Zaloguj się swoim zwykłym kontem na oficjalnej stronie TIDAL. Hasło wpisujesz wyłącznie w przeglądarce. Identyfikator poniżej określa aplikację AMC, nie inne konto użytkownika. Jeśli konto już działa, nie zmieniaj identyfikatora ani adresu powrotu. Pierwszą konfigurację opisuje dołączona instrukcja logowania." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <controls:AccessibleStatusTextBlock x:Name="OperationStatusText" Margin="0,0,0,10"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.Name="Stan konta TIDAL"
                                                automation:AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button x:Name="DeveloperPanelButton" Content="Otwórz _panel aplikacji TIDAL" Margin="0,0,8,8"
                        Click="DeveloperPanel_Click" />
                <Button x:Name="SaveButton" Content="_Zapisz ustawienia" Margin="0,0,8,8"
                        Click="Save_Click" />
                <Button x:Name="LoginButton" Content="Za_loguj w przeglądarce" Margin="0,0,8,8"
                        Click="Login_Click" />
                <Button x:Name="SyncButton" Content="_Synchronizuj teraz" Margin="0,0,8,8"
                        Click="Sync_Click" />
                <Button x:Name="DiagnosticsButton" Content="_Diagnostyka odtwarzania" Margin="0,0,8,8"
                        automation:AutomationProperties.Name="Diagnostyka odtwarzania"
                        automation:AutomationProperties.HelpText="Alt+D. Pokaż raport ostatniej próby, bez ponownego logowania i bez rozpoczynania odtwarzania."
                        Click="Diagnostics_Click" />
                <Button x:Name="DisconnectButton" Content="_Odłącz konto…" Margin="0,0,8,8"
                        Click="Disconnect_Click" />
                <Button Content="Za_mknij" IsCancel="True" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=ClientIdBox}">_Identyfikator aplikacji:</Label>
                <TextBox x:Name="ClientIdBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                         automation:AutomationProperties.Name="Identyfikator aplikacji TIDAL"
                         automation:AutomationProperties.HelpText="Client ID z panelu TIDAL Developer. Nie wpisuj tutaj sekretu aplikacji." />

                <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=RedirectUriBox}">Adres _powrotu:</Label>
                <TextBox x:Name="RedirectUriBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                         automation:AutomationProperties.Name="Adres powrotu logowania TIDAL"
                         automation:AutomationProperties.HelpText="Skopiuj ten adres dokładnie do ustawień aplikacji w panelu TIDAL." />

                <Label Grid.Row="2" Grid.Column="0" Target="{Binding ElementName=CountryCodeBox}">_Kraj katalogu:</Label>
                <TextBox x:Name="CountryCodeBox" Grid.Row="2" Grid.Column="1" Width="80"
                         HorizontalAlignment="Left" Margin="8,0,0,8" MaxLength="2"
                         automation:AutomationProperties.Name="Dwuliterowy kod kraju katalogu TIDAL"
                         automation:AutomationProperties.HelpText="Dla Polski wpisz PL." />

                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" FontWeight="SemiBold"
                           Text="Co jest synchronizowane" automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="Z konta są pobierane kolekcje utworów, albumów, wykonawców, playlist i materiałów wideo. AMC może dodawać i usuwać ich elementy. Kolejka, historia, zakładki, presety i ustawienia pozostają lokalne. Dźwięk obsługuje oficjalny moduł Player TIDAL. Działająca synchronizacja nie potwierdza prawa aplikacji do pełnych utworów. Przycisk Diagnostyka odtwarzania pokazuje wynik ostatniej próby." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</controls:AccessibleWindow>
