<controls:AccessibleWindow x:Class="AccessibleMediaController.Windows.SpotifyAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Konto Spotify" Width="740" Height="560"
        MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closing="Window_Closing" Closed="Window_Closed">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Konto Spotify" FontSize="18" FontWeight="SemiBold"
                       automation:AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Zaloguj się swoim zwykłym kontem na oficjalnej stronie Spotify. Hasło wpisujesz wyłącznie w przeglądarce, AMC go nie widzi. Identyfikator poniżej określa aplikację AMC, nie Twoje konto. Odtwarzanie wewnątrz AMC wymaga konta Premium; bez Premium zostaje biblioteka i sterowanie oficjalną aplikacją Spotify." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <controls:AccessibleStatusTextBlock x:Name="OperationStatusText" Margin="0,0,0,10"
                                                TextWrapping="Wrap"
                                                automation:AutomationProperties.Name="Stan konta Spotify"
                                                automation:AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button x:Name="DeveloperPanelButton" Content="Otwórz _panel aplikacji Spotify" Margin="0,0,8,8"
                        automation:AutomationProperties.HelpText="Otwiera stronę developer.spotify.com w przeglądarce, gdzie tworzy się aplikację i odczytuje identyfikator."
                        Click="DeveloperPanel_Click" />
                <Button x:Name="SaveButton" Content="_Zapisz ustawienia" Margin="0,0,8,8"
                        Click="Save_Click" />
                <Button x:Name="LoginButton" Content="Za_loguj w przeglądarce" Margin="0,0,8,8"
                        Click="Login_Click" />
                <Button x:Name="CheckAccountButton" Content="_Sprawdź konto" Margin="0,0,8,8"
                        automation:AutomationProperties.HelpText="Odczytuje nazwę konta i rodzaj abonamentu, bez ponownego logowania."
                        Click="CheckAccount_Click" />
                <Button x:Name="InstructionsButton" Content="_Instrukcja pierwszego logowania" Margin="0,0,8,8"
                        Click="Instructions_Click" />
                <Button x:Name="DisconnectButton" Content="_Odłącz konto…" Margin="0,0,8,8"
                        Click="Disconnect_Click" />
                <Button Content="Za_mknij" IsCancel="True" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Target="{Binding ElementName=ClientIdBox}">_Identyfikator aplikacji:</Label>
                <TextBox x:Name="ClientIdBox" Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                         automation:AutomationProperties.Name="Identyfikator aplikacji Spotify"
                         automation:AutomationProperties.HelpText="Client ID z panelu Spotify for Developers. Nie wpisuj tutaj sekretu aplikacji: AMC go nie potrzebuje." />

                <Label Grid.Row="1" Grid.Column="0" Target="{Binding ElementName=RedirectUriBox}">Adres _powrotu:</Label>
                <TextBox x:Name="RedirectUriBox" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                         automation:AutomationProperties.Name="Adres powrotu logowania Spotify"
                         automation:AutomationProperties.HelpText="Skopiuj ten adres dokładnie do ustawień aplikacji w panelu Spotify, razem z ukośnikiem na końcu. Spotify nie przyjmuje nazwy localhost, tylko 127.0.0.1." />

                <Label Grid.Row="2" Grid.Column="0" Target="{Binding ElementName=CountryCodeBox}">_Kraj katalogu:</Label>
                <TextBox x:Name="CountryCodeBox" Grid.Row="2" Grid.Column="1" Width="80"
                         HorizontalAlignment="Left" Margin="8,0,0,8" MaxLength="2"
                         automation:AutomationProperties.Name="Dwuliterowy kod kraju katalogu Spotify"
                         automation:AutomationProperties.HelpText="Dla Polski wpisz PL. Po zalogowaniu AMC wpisuje tu kraj Twojego konta." />

                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" FontWeight="SemiBold"
                           Text="Co AMC robi z kontem Spotify" automation:AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="AMC prosi o prawo do odtwarzania na Twoim koncie, czytania Twojej biblioteki i playlist oraz sterowania odtwarzaniem. Nie prosi o prawo do zmieniania czegokolwiek na koncie. Hasło zostaje w przeglądarce, a token logowania w Menedżerze poświadczeń Windows: nie ma go w pliku ustawień, w kopiach zapasowych ani w dzienniku. Uwaga na ograniczenie po stronie Spotify: zawartości playlist redakcyjnych Spotify nie da się pokazać, bo Spotify odciął do nich dostęp w lutym 2026. Twoje własne playlisty są dostępne w całości." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</controls:AccessibleWindow>
