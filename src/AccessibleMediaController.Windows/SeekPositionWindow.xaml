<Window x:Class="AccessibleMediaController.Windows.SeekPositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="InstructionsText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Label x:Name="ValueLabel" Grid.Row="1" Target="{Binding ElementName=ValueBox}" Padding="0,0,0,3" />
        <TextBox x:Name="ValueBox" Grid.Row="2" MinWidth="310"
                 automation:AutomationProperties.Name="Wartość skoku" />
        <controls:AccessibleStatusTextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,8,0,0"
                                             Foreground="DarkRed" TextWrapping="Wrap"
                                             automation:AutomationProperties.Name="Błąd wartości"
                                             automation:AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button MinWidth="100" Margin="0,0,8,0" IsDefault="True" Content="_Skocz" Click="Confirm_Click" />
            <Button MinWidth="100" IsCancel="True" Content="_Anuluj" />
        </StackPanel>
    </Grid>
</Window>
