<Window x:Class="AccessibleMediaController.Windows.SonosLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:AccessibleMediaController.Windows.Controls"
        Title="Biblioteka Sonos" Width="560" Height="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!--
      BIBLIOTEKA MATERIALU Sonosa: kategorie "Ulubione Sonos" i "Playlisty Sonos".
      GLOSNIKI I GRUPY TU NIE NALEZA - to CEL STEROWANIA pod Ctrl+F5.

      Uklad celowo identyczny z odebranymi oknami Sonosa: naglowek, wstep, lista,
      przyciski, status. Samo otwarcie i ruch po liscie NIE wysylaja zapytan.
    -->
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Text="Biblioteka Sonos"
                   FontSize="18" FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="IntroductionText" DockPanel.Dock="Top" Margin="0,0,0,10"
                   TextWrapping="Wrap" />
        <controls:AccessibleStatusTextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Margin="0,10,0,0" TextWrapping="Wrap"
                   automation:AutomationProperties.LiveSetting="Polite" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenButton" Width="130" Content="_Otwórz kategorię" Margin="0,0,8,0"
                    automation:AutomationProperties.Name="Otwórz kategorię"
                    Click="Open_Click" />
            <Button x:Name="CloseButton" Width="95" Content="_Zamknij"
                    IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <ListBox x:Name="CategoryList" DisplayMemberPath="Name" TextSearch.TextPath="Name"
                 automation:AutomationProperties.Name="Kategorie Biblioteki Sonos">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="automation:AutomationProperties.HelpText" Value="{Binding Hint}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
