<Window x:Class="AccessibleMediaController.Windows.RadioSchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Harmonogram nagrywania radia" Width="760" Height="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Insert dodaje plan, Enter go edytuje, Delete usuwa. Nagrania są tworzone w tle w formacie wybranym w ustawieniach i nie zmieniają słuchanej stacji."/>
        <CheckBox x:Name="GlobalWakeCheckBox" DockPanel.Dock="Bottom" Margin="0,10,0,8"
                  Content="Domyślnie wybudzaj komputer przed zaplanowanym nagraniem"
                  automation:AutomationProperties.Name="Domyślnie wybudzaj komputer przed zaplanowanym nagraniem"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Nowy…" MinWidth="90" Margin="0,0,8,0" Click="New_Click"/>
            <Button Content="_Edytuj…" MinWidth="90" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="_Usuń" MinWidth="90" Margin="0,0,16,0" Click="Delete_Click"/>
            <Button Content="_Zapisz" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Anuluj" IsCancel="True" MinWidth="90"/>
        </StackPanel>
        <ListBox x:Name="SchedulesList" SelectionMode="Single"
                 automation:AutomationProperties.Name="Zaplanowane nagrania radia"
                 MouseDoubleClick="SchedulesList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"
                               automation:AutomationProperties.Name="{Binding Label}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
