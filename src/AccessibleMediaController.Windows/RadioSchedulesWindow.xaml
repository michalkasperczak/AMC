<Window x:Class="AccessibleMediaController.Windows.RadioSchedulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Harmonogram nagrywania radia" Width="760" Height="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Insert dodaje plan, Enter go edytuje, Spacja włącza lub wyłącza, a Delete usuwa. Zmiany zaczynają obowiązywać po wybraniu Zapisz. Nagrania są tworzone w tle i nie zmieniają słuchanej stacji."/>
        <CheckBox x:Name="GlobalWakeCheckBox" DockPanel.Dock="Bottom" Margin="0,10,0,8"
                  Content="Domyślnie wybudzaj komputer przed zaplanowanym nagraniem"
                  automation:AutomationProperties.Name="Domyślnie wybudzaj komputer przed zaplanowanym nagraniem"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="_Nowy…" MinWidth="90" Margin="0,0,8,0" Click="New_Click"/>
            <Button Content="_Edytuj…" MinWidth="90" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="Włącz lub w_yłącz" MinWidth="120" Margin="0,0,8,0" Click="ToggleEnabled_Click"
                    automation:AutomationProperties.Name="Włącz lub wyłącz zaznaczony plan"/>
            <Button Content="_Usuń" MinWidth="90" Margin="0,0,16,0" Click="Delete_Click"/>
            <Button Content="_Zapisz" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Anuluj" IsCancel="True" MinWidth="90"/>
        </StackPanel>
        <TextBlock x:Name="ScheduleStatus" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   TextWrapping="Wrap" automation:AutomationProperties.Name="Wynik zmiany planu"
                   automation:AutomationProperties.LiveSetting="Assertive" />
        <ListBox x:Name="SchedulesList" SelectionMode="Single"
                 automation:AutomationProperties.Name="Zaplanowane nagrania radia"
                 automation:AutomationProperties.HelpText="Strzałki wybierają plan. Spacja włącza lub wyłącza go bez otwierania edytora."
                 MouseDoubleClick="SchedulesList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Schedule.Enabled}"
                              Focusable="False" IsHitTestVisible="False"
                              automation:AutomationProperties.Name="{Binding AccessibleLabel}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding AccessibleLabel}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </DockPanel>
</Window>
