    <Compile Include="..\AccessibleMediaController.Windows\Services\RadioStreamTitleMetadata.cs"
             Link="Engine\RadioStreamTitleMetadata.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\BassRadioWaveProvider.cs"
             Link="Engine\BassRadioWaveProvider.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\FfmpegRadioWaveProvider.cs"
