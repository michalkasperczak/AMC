             Link="Engine\SpotifyLibrespotMediaOutput.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SpotifyLibrespotAuthenticationService.cs"
             Link="Engine\SpotifyLibrespotAuthenticationService.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SpotifyLibrespotCredentialStore.cs"
             Link="Engine\SpotifyLibrespotCredentialStore.cs" />
    <!-- Pelne odtwarzanie TIDAL pozostaje w oryginalnej aplikacji. Linkujemy
         sprawdzony kontroler wskazywania utworu i oficjalne sterowanie SMTC. -->
    <Compile Include="..\AccessibleMediaController.Windows\Services\TidalDesktopController.cs"
             Link="Engine\TidalDesktopController.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\ExternalMediaController.cs"
             Link="Engine\ExternalMediaController.cs" />
    <!-- Sonos korzysta z tego samego zaszyfrowanego magazynu DPAPI co główne
         AMC. Plik nie zależy od WPF i jest linkowany zamiast kopiowany. -->
