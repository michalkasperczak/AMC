             Link="Engine\RadioBrowserClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\RadioRecordingStagingStore.cs"
             Link="Engine\RadioRecordingStagingStore.cs" />
    <!-- Reczne nagrania wx korzystaja z DOKLADNIE tego samego prywatnego,
         nieslyszalnego toru i sterowania czesciami co pelne AMC. -->
    <Compile Include="..\AccessibleMediaController.Windows\Services\RadioRecordingControl.cs"
             Link="Engine\RadioRecordingControl.cs" />
    <!-- Rozpoznawanie korzysta z tego samego podpisu akustycznego co główne
         AMC. Do usługi wychodzi wyłącznie podpis, nie nagranie ani URL. -->
