             Link="Engine\ApplePodcastDirectoryClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SpreakerPodcastDirectoryClient.cs"
             Link="Engine\SpreakerPodcastDirectoryClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\YouTubeSearchClient.cs"
             Link="Engine\YouTubeSearchClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\PodcastEpisodeDownloader.cs"
             Link="Engine\PodcastEpisodeDownloader.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\YouTubeMediaDownloader.cs"
             Link="Engine\YouTubeMediaDownloader.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\YouTubeDownloadVariantCatalog.cs"
             Link="Engine\YouTubeDownloadVariantCatalog.cs" />
    <!-- Katalog TIDAL: dokladnie ten sam klient, odswiezanie tokenu i
         Menedzer poswiadczen co w glownym AMC. Bez WPF i bez kopiowania
         sekretow do Pythona albo protokolu. -->
