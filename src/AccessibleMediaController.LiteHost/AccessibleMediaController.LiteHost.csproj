             Link="Engine\TidalIntegrationService.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\TidalCredentialStore.cs"
             Link="Engine\TidalCredentialStore.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\TidalOAuthClient.cs"
             Link="Engine\TidalOAuthClient.cs" />
    <!-- Spotify catalogue and explicit account login. OAuth starts only after
         the user activates the account command; credentials stay in Windows
         Credential Manager and never cross the Python protocol. -->
    <Compile Include="..\AccessibleMediaController.Windows\Services\SpotifyApiClient.cs"
             Link="Engine\SpotifyApiClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SpotifyIntegrationService.cs"
             Link="Engine\SpotifyIntegrationService.cs" />
