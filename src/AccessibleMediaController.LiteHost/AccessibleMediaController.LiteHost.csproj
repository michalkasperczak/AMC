             Link="Engine\PodcastFeedClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SoundCloudPodcastClient.cs"
             Link="Engine\SoundCloudPodcastClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\FacebookPublicPageClient.cs"
             Link="Engine\FacebookPublicPageClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\SoundCloudPodcastDirectoryClient.cs"
             Link="Engine\SoundCloudPodcastDirectoryClient.cs" />
    <Compile Include="..\AccessibleMediaController.Windows\Services\PodcastChapterClient.cs"
